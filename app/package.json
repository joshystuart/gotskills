{
  "name": "got-skills",
  "version": "0.0.8",
  "description": "Got Skills — internal app store for agent skills (Phase 0 PoC)",
  "author": "Got Skills",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "compile": "electron-vite build",
    "build": "npm run build:dev",
    "build:dev": "electron-vite build && electron-builder --config electron-builder.dev.config.mjs --mac --publish never",
    "build:release": "electron-vite build && electron-builder --config electron-builder.config.mjs --mac --publish never",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.dev.config.mjs --mac --arm64 --dir",
    "render:dmg-background": "node scripts/render-dmg-background.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.cjs run",
    "test:watch": "node scripts/run-vitest.cjs",
    "resign:electron": "install-electron && xattr -cr node_modules/electron/dist/Electron.app && codesign --force --deep --sign - node_modules/electron/dist/Electron.app",
    "postinstall": "npm run resign:electron"
  },
  "dependencies": {
    "skills": "^1.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
