{
  "name": "got-skills",
  "version": "0.0.22",
  "description": "Got Skills — internal app store for agent skills (Phase 0 PoC)",
  "author": "Got Skills",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tauri build",
    "build:release": "tauri build --bundles app,dmg,updater --config '{\"bundle\":{\"createUpdaterArtifacts\":true}}'",
    "render:dmg-background": "node scripts/render-dmg-background.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.5.0",
    "jsdom": "^31.0.1",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
