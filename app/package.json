{
  "name": "got-skills",
  "version": "0.0.15",
  "description": "Got Skills \u2014 internal app store for agent skills (Phase 0 PoC)",
  "author": "Got Skills",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:release": "tauri build --bundles app,dmg,updater --config '{\"bundle\":{\"createUpdaterArtifacts\":true}}'",
    "render:dmg-background": "node scripts/render-dmg-background.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.16",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
