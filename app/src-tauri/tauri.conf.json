{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Got Skills",
  "version": "../package.json",
  "identifier": "com.igotskills.app",
  "build": {
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Got Skills",
        "width": 1180,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
