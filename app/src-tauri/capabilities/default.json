{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-write-text"
  ]
}
