name: subagent-styles
repo: .
base: 6ec95b3 # before #16, which built this plan
plan: .scratch/existing-skill-collisions
pre_build: [npm ci, cd app && npm ci]
checks: npm run check
concurrency: 1
auth: subscription
limits: { timeout_minutes: 240 }
languages: [typescript, rust]
variants:
  - name: simple-subagents
    prompt: .bench/prompts/simple-subagents.md
    model: claude-sonnet-5-5
    effort: medium
  - name: simple-no-subagents
    prompt: .bench/prompts/simple-subagents.md
    model: claude-sonnet-5-5
    effort: medium
  - name: pocock-subagents
    prompt: .bench/prompts/pocock-subagents.md
    model: claude-sonnet-5-5
    effort: medium
    skills:
      - ~/.agents/skills/implement-spec
      - ~/.agents/skills/tdd
      - ~/.agents/skills/code-review
  - name: pipeline-subagents
    prompt: .bench/prompts/pipeline-subagents.md
    model: claude-sonnet-5-5
    effort: medium
    skills:
      - ~/.agents/skills/xf-build
      - ~/.agents/skills/xf-common
      - ~/.agents/skills/xf-plan
      - ~/.agents/skills/xf-plan-grill
      - ~/.agents/skills/xf-plan-spec
      - ~/.agents/skills/xf-plan-tickets
      - ~/.agents/skills/xf-review
judges:
  - name: gpt
    type: copilot
    model: gpt-6.1-terra
  - name: sol
    type: api
    model: openrouter/openai/gpt-6.1-sol # check this slug on openrouter.ai/openai
    limits: { timeout_minutes: 10 }
merge_judge: gpt
