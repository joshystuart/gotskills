name: subagent-styles
repo: .
base: 6ec95b3 # before #16, which built this plan
plan: .scratch/existing-skill-collisions
pre_build: [npm ci, cd app && npm ci]
env:
  PATH: $HOME/.cargo/bin:${PATH}
  TMPDIR: $HOME/.cache/bench-tmp # under /home, so the app's error redaction covers temp paths as /var/folders does on macOS
  CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS: "0" # wait for background subagents instead of stopping them 10m after the last turn; limits.timeout_minutes still caps the Trial
  CARGO_TARGET_DIR: $HOME/.cache/bench-cargo-target # one Rust build folder for every checkout, so worktrees reuse compiled dependencies and wait on each other instead of each compiling ~5 GB at once
runtime_check: mkdir -p "$TMPDIR" && node --version | grep -q '^v24\.' && cargo --version
checks:
  - name: format
    command: npm run format:check
  - name: typecheck
    command: cd app && npm run typecheck
  - name: test
    command: cd app && npx vitest run --retry 2 --exclude scripts/releaseWorkflow.test.ts # the excluded test's `sed -i ''` only runs on macOS; --retry absorbs the Console sidebar test's race on the sync status
  - name: rust
    command: cd app && npm run test:rust
  - name: app-size
    command: cd app && node --test scripts/check-app-size.test.cjs
check_base: true
judge_guidance: .bench/judge-guidance.md
concurrency: 1
auth: subscription
limits: { timeout_minutes: 240, max_budget_usd: 15 }
languages: [typescript, rust]
variants:
  - name: simple-subagents
    prompt: .bench/prompts/simple-subagents.md
    model: claude-sonnet-5-5
    effort: medium
    repeats: 3
  - name: simple-no-subagents
    prompt: .bench/prompts/simple-no-subagents.md
    model: claude-sonnet-5-5
    effort: medium
    repeats: 3
  - name: pocock-subagents
    prompt: .bench/prompts/pocock-subagents.md
    model: claude-sonnet-5-5
    effort: medium
    repeats: 3
    skills:
      - ~/.agents/skills/implement-spec
      - ~/.agents/skills/tdd
      - ~/.agents/skills/code-review
  - name: pipeline-subagents
    prompt: .bench/prompts/pipeline-subagents.md
    model: claude-sonnet-5-5
    effort: medium
    repeats: 3
    skills:
      - ~/.agents/skills/xf-build
      - ~/.agents/skills/xf-common
      - ~/.agents/skills/xf-plan
      - ~/.agents/skills/xf-plan-grill
      - ~/.agents/skills/xf-plan-spec
      - ~/.agents/skills/xf-plan-tickets
      - ~/.agents/skills/xf-review
judges:
  - name: terra
    type: api
    model: openrouter/openai/gpt-6.1-terra
    limits: { timeout_minutes: 20 }
  - name: sol
    type: api
    model: openrouter/openai/gpt-6.1-sol
    limits: { timeout_minutes: 20 }
    compare: { max_pairs: 18 } # each Trial once against each other Variant
  - name: gemini
    type: api
    model: openrouter/google/gemini-4-argon
    limits: { timeout_minutes: 20 }
merge_judge: terra
